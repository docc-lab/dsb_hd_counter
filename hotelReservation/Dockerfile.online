# Online predictor image template.
#
# Builds a per-service image with the gRPC service binary plus an
# in-pod ONNX score source baked in. The "online" tag distinguishes
# this image from the base image (no predictor) and from the deferred
# aggressor / co-located workload manifests; this Dockerfile produces
# only the victim-side predictor image.
#
# Build args:
#   SVC          - which service binary to package (e.g. "search")
#   ONNX_RT_VER  - ONNX Runtime version; pinned to 1.18.0
#
# Inputs (must exist at build time, relative to build context):
#   artifacts/${SVC}.onnx              trained model
#   artifacts/${SVC}-shortlist.json    metadata-only shortlist
#
# Build:
#   docker build -t gordion-online-search:v1.0 \
#       --build-arg SVC=search \
#       -f Dockerfile.online .
#
# This is a multi-stage build:
#   1. base-build: same as the original Dockerfile, builds all Go binaries.
#   2. online:     adds libonnxruntime.so + per-service .onnx/shortlist
#                  on top, sets GORDION_* env vars.
#
# Per the plan (M8), the runtime image is one container, one process,
# one image per service. New model = new image tag = rolling restart.

ARG ONNX_RT_VER=1.18.0

# ── Stage 1: Go build (mirrors existing Dockerfile) ──────────────────────
FROM golang:1.21 AS base-build

RUN apt-get update && apt-get install -y gcc

WORKDIR /workspace

COPY go.sum go.sum
COPY go.mod go.mod
COPY vendor/ vendor/

COPY cmd/ cmd/
COPY dialer/ dialer/
COPY interceptor/ interceptor/
COPY registry/ registry/
COPY services/ services/
COPY tls/ tls/
COPY tracing/ tracing/
COPY tune/ tune/

COPY config.json config.json

# Build perf C library (existing)
WORKDIR /workspace/services/perf
RUN gcc -std=c11 -c perf_api.c -o perf_api.o && ar rcs libperf_api.a perf_api.o

WORKDIR /workspace

ENV CGO_ENABLED=1 \
    CGO_LDFLAGS="-L/workspace/services/perf -lperf_api" \
    CGO_CFLAGS="-I/workspace/services/perf"

RUN GOOS=linux GO111MODULE=on go install -mod=vendor ./cmd/...

# ── Stage 2: Online predictor runtime image ──────────────────────────────
FROM debian:bookworm-slim AS online

ARG SVC
ARG ONNX_RT_VER

# wget + ca-certificates for the ONNX Runtime download; tini for clean
# signal handling; libgcc for CGO.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates wget tini libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

# Pull ONNX Runtime 1.18.0 (paired with github.com/yalue/onnxruntime_go@v1.10.0;
# the colleague's scenario_onnx_go.go validates this combo end-to-end).
RUN wget -q "https://github.com/microsoft/onnxruntime/releases/download/v${ONNX_RT_VER}/onnxruntime-linux-x64-${ONNX_RT_VER}.tgz" \
        -O /tmp/ort.tgz \
    && tar -xzf /tmp/ort.tgz -C /opt \
    && cp /opt/onnxruntime-linux-x64-${ONNX_RT_VER}/lib/libonnxruntime.so* /usr/lib/ \
    && rm -rf /opt/onnxruntime-linux-x64-${ONNX_RT_VER} /tmp/ort.tgz

# The Go binary built in stage 1.
COPY --from=base-build /go/bin/${SVC} /usr/local/bin/${SVC}

# Per-service online-predictor artifacts (model + shortlist).
COPY artifacts/${SVC}.onnx              /etc/gordion/model.onnx
COPY artifacts/${SVC}-shortlist.json    /etc/gordion/shortlist.json

# Online predictor env defaults; cmd/internal/stage3wire/setup.go reads these.
ENV GORDION_MODEL=/etc/gordion/model.onnx \
    GORDION_SHORTLIST=/etc/gordion/shortlist.json \
    GORDION_LIBONNXRUNTIME=/usr/lib/libonnxruntime.so \
    GORDION_SCORE_SOURCE=onnx \
    GORDION_SCORE_PORT=7900 \
    GORDION_INSTRUMENTATION_PORT=7901 \
    GORDION_INFLIGHT_DEPTH=16 \
    GORDION_SUBSCRIBER_BUFFER=64

# Run as the same process the original image runs (one binary per image
# in the online layout). Using tini for proper PID 1 / signal handling
# of the gRPC servers' graceful shutdown.
EXPOSE 8082 7900 7901
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["${SVC}"]

# Note: the CMD literal interpolation above doesn't work in plain CMD.
# To set the CMD per-svc at build time, use a small entrypoint script
# OR override the CMD at deploy time:
#
#   spec:
#     containers:
#       - command: ["search"]
#
# (which the existing kubernetes/search/search-deployment.yaml already
# does). The CMD line above is documentation; the actual command comes
# from the Deployment manifest.
